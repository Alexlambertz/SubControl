# Application
DEV_MODE=true
DATABASE_URL=sqlite+aiosqlite:///./data/subcontrol.db
SECRET_KEY=change-me-in-production

# OIDC / Keycloak (used when DEV_MODE=false)
OIDC_ISSUER_URL=http://localhost:8080/realms/subcontrol
# Set OIDC_PUBLIC_ISSUER_URL only when the backend reaches Keycloak on an
# internal Docker hostname (e.g. http://keycloak:8080/realms/subcontrol)
# but the browser needs a different public URL.  Leave empty to reuse OIDC_ISSUER_URL.
OIDC_PUBLIC_ISSUER_URL=
OIDC_CLIENT_ID=subcontrol
OIDC_CLIENT_SECRET=

# AI Chat
# Values set here take priority over the Settings UI in the app.
# Leave blank to configure through the Settings page instead.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# MCP Server
SUBCONTROL_API_URL=http://localhost:8000
SUBCONTROL_API_KEY=
